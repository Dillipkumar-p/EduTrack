# ==============================================================================
# OmniLearn Environment Configuration Template
# Copy this file to '.env' and fill in your actual configuration.
# NEVER commit your real '.env' file to source control.
# ==============================================================================

# Flask Security Secret (Generate a strong random key for production)
FLASK_SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars
FLASK_ENV=production

# MySQL Database Configuration
# For local MySQL:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_local_mysql_password
MYSQL_DATABASE=OmniLearn_db
MYSQL_SSL_CA=

# For Aiven Cloud MySQL:
# MYSQL_HOST=mysql-xxxx-project.aivencloud.com
# MYSQL_PORT=20186
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=your_aiven_password
# MYSQL_DATABASE=defaultdb
# MYSQL_SSL_CA=ca.pem   (Download Aiven CA certificate and set path if required)

# Contact Enquiries & Email Notifications (SMTP)
ADMIN_EMAIL=admin@OmniLearn.edu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=notifications@OmniLearn.edu
